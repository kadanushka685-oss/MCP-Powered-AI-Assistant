# Copy this file to ".env" (same folder) and edit the copy. NEVER commit ".env".
# Everything is optional: with no values at all the project runs in DEMO MODE.

# ---- Claude API (optional) -------------------------------------------------
# Get a key at https://console.anthropic.com/ . Leave empty to stay in demo mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Set to true to force demo mode even when a key is present
DEMO_MODE=false

# ---- Database --------------------------------------------------------------
# sqlite (default, no setup) or postgres
DB_BACKEND=sqlite
# Optional custom location of the SQLite file (default: database/sales.db)
SQLITE_DB_PATH=
# Only for DB_BACKEND=postgres, e.g. postgresql://user:password@localhost:5432/salesdb
DATABASE_URL=

# ---- Optional real integrations (leave empty to use clearly-labelled MOCKS) --
SLACK_WEBHOOK_URL=
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=
CRM_BASE_URL=
CRM_API_KEY=
